<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/HomeFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.tealamore.kthd.HomeFragment"
        android:label="@string/home_fragment_label"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_HomeFragment_to_CreateTaskFragment"
            app:destination="@id/CreateTaskFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_ActiveTaskFragment"
            app:destination="@id/ActiveTaskFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_CompletedTasksFragment"
            app:destination="@id/CompletedTasksFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_PermissionFragment"
            app:destination="@id/PermissionFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_SettingsFragment"
            app:destination="@id/SettingsFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_ConsentFragment"
            app:destination="@id/ConsentFragment" />
    </fragment>

    <fragment
        android:id="@+id/ConsentFragment"
        android:name="com.tealamore.kthd.ConsentFragment"
        android:label="Consent Required"
        tools:layout="@layout/fragment_consent">
        <action
            android:id="@+id/action_ConsentFragment_to_HomeFragment"
            app:destination="@id/HomeFragment"
            app:popUpTo="@id/HomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.tealamore.kthd.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_SettingsFragment_to_ConsentFragment"
            app:destination="@id/ConsentFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/PermissionFragment"
        android:name="com.tealamore.kthd.PermissionFragment"
        android:label="Permission Required"
        tools:layout="@layout/fragment_permission" />

    <fragment
        android:id="@+id/CompletedTasksFragment"
        android:name="com.tealamore.kthd.CompletedTasksFragment"
        android:label="Completed Tasks"
        tools:layout="@layout/fragment_completed_tasks" />

    <fragment
        android:id="@+id/CreateTaskFragment"
        android:name="com.tealamore.kthd.CreateTaskFragment"
        android:label="@string/create_task_fragment_label"
        tools:layout="@layout/fragment_create_task">

        <action
            android:id="@+id/action_CreateTaskFragment_to_ActiveTaskFragment"
            app:destination="@id/ActiveTaskFragment"
            app:popUpTo="@id/HomeFragment" />
    </fragment>

    <fragment
        android:id="@+id/ActiveTaskFragment"
        android:name="com.tealamore.kthd.ActiveTaskFragment"
        android:label="Active Task"
        tools:layout="@layout/fragment_active_task">
        <action
            android:id="@+id/action_ActiveTaskFragment_to_HomeFragment"
            app:destination="@id/HomeFragment"
            app:popUpTo="@id/HomeFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
